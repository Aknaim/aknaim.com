{
  "name": "aknaim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "node scripts/with-plain-public-media.mjs npm run preview:cf",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/with-plain-public-media.mjs npm run deploy:cf",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "media:sync-r2": "tsx scripts/sync-media-to-r2.ts",
    "db:push-neon": "tsx scripts/push-local-db-to-neon.ts",
    "db:rewrite-neon-media": "tsx scripts/rewrite-neon-media-urls.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up:all": "docker compose --env-file .env.docker up -d --build",
    "docker:down:all": "docker compose --env-file .env.docker down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.16.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "wrangler": "^4.146.0"
  }
}
