# Local development only — copy to `.env` (never commit `.env`).
# Production Neon URLs belong in Cloudflare Worker secrets, not here.

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=aknaim
POSTGRES_PASSWORD=aknaim
POSTGRES_DB=aknaim
POSTGRES_PORT=5432

# Active DB for next dev / drizzle / seed — LOCAL Docker by default
DATABASE_URL=postgresql://aknaim:aknaim@localhost:5432/aknaim
# WSL + Docker Desktop:
# DATABASE_URL=postgresql://aknaim:aknaim@host.docker.internal:5432/aknaim

# Optional: Neon URL for db:pull-neon / compare scripts only.
# NEVER point DATABASE_URL at Neon. db:seed refuses neon.tech hosts.
# DATABASE_URL_NEON_PRODUCTION=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Quote if the password contains # (otherwise everything after # is a comment).
# Production Worker secrets: ADMIN_PASSWORD ≥12 chars (not "changeme");
# SESSION_SECRET ≥24 chars random (not "dev-secret"). Missing/weak → login fails closed.
ADMIN_PASSWORD="changeme-locally"
SESSION_SECRET=replace-with-long-random-string

# Post-deploy ISR bust (`npm run refresh:public` / end of `npm run deploy`).
# Required: same value as Worker secret REVALIDATE_SECRET (not SESSION_SECRET).
# SITE_URL=https://aknaim.com
REVALIDATE_SECRET=replace-with-long-random-string
# Optional Cloudflare zone purge after revalidate (same secrets OpenNext cachePurge uses):
# CACHE_PURGE_ZONE_ID=
# CACHE_PURGE_API_TOKEN=

# Media uploads: local next dev defaults to filesystem.
# Keep `public/media` as a normal folder (NOT a Windows junction) so deploys build.
# Point LOCAL_MEDIA_ROOT at your large local library (served via /media/... in dev).
# LOCAL_MEDIA_ROOT=C:\Users\you\Pictures\aknaim.com\media
# MEDIA_DRIVER=local

# Cloudflare R2 — Worker secrets for production.
# For a one-time `npm run media:sync-r2`, you may temporarily add these to `.env`,
# then remove the write keys again afterward.
# TODO: add a separate aknaim-media-dev bucket for local uploads (own R2_* + public URL);
# keep Worker secrets on the prod bucket only.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aknaim-media
# R2_PUBLIC_BASE_URL=https://media.aknaim.com
#
# Browser uploads (videos) PUT straight to R2 via presigned URLs.
# On the bucket → Settings → CORS, allow your site origins, e.g.:
#   AllowedOrigins: https://www.aknaim.com, https://aknaim.com, http://localhost:3000
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: Content-Type
#   MaxAgeSeconds: 3600

WEB_PORT=3000
