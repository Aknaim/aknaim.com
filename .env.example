# Local development only — copy to `.env` (never commit `.env`).
# Production Neon URLs belong in Cloudflare Worker secrets, not here.

# Postgres (docker-compose.dev.yml)
POSTGRES_USER=aknaim
POSTGRES_PASSWORD=aknaim
POSTGRES_DB=aknaim
POSTGRES_PORT=5432

# Active DB for next dev / drizzle / seed — LOCAL Docker by default
DATABASE_URL=postgresql://aknaim:aknaim@localhost:5432/aknaim
# WSL + Docker Desktop:
# DATABASE_URL=postgresql://aknaim:aknaim@host.docker.internal:5432/aknaim

# Optional: keep a Neon URL for rare intentional production seeds only.
# Do NOT point DATABASE_URL at this while developing.
# DATABASE_URL_NEON_PRODUCTION=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Quote if the password contains # (otherwise everything after # is a comment).
ADMIN_PASSWORD="changeme-locally"
SESSION_SECRET=replace-with-long-random-string

# Media uploads: local next dev defaults to filesystem (public/media).
# Production defaults to R2. Override with MEDIA_DRIVER=local|r2.
# Do NOT put prod R2 write keys in local .env.
# MEDIA_DRIVER=local

# Cloudflare R2 — Worker secrets for production only (or a separate *dev* bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=aknaim-media
# R2_PUBLIC_BASE_URL=https://media.aknaim.com

WEB_PORT=3000
